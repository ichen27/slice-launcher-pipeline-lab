{
  "name": "@slice/launcher",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@slice/ui": "workspace:*",
    "@vinext/cloudflare": "1.0.1",
    "jose": "^6.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.62.5",
    "@playwright/test": "^1.63.0",
    "@slice/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "5.0.3",
    "miniflare": "5.20261001.0-alpha",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "preview": "pnpm build && pnpm start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:migrations": "vitest run --config vitest.config.ts src/membership/migrations.test.ts",
    "test:e2e:server": "tsx tests/e2e/server.ts"
  }
}
